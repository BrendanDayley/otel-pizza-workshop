# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens
#
# Only the collector reads these. The three services send to the collector and
# never see the token.

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint, port :4317 included. Confirm yours under
# https://app.dash0.com/settings/endpoints → OTLP via gRPC.
# - US East (N. Virginia):  https://ingress.us-east-1.aws.dash0.com:4317
# - US West (Oregon):       https://ingress.us-west-2.aws.dash0.com:4317
# - EU Central (Frankfurt): https://ingress.eu-central-1.aws.dash0.com:4317
# - EU West (Ireland):      https://ingress.eu-west-1.aws.dash0.com:4317
# - EU West (GCP):          https://ingress.europe-west4.gcp.dash0.com:4317
#
# There is no us-east-2 region. `ingress.us-east-2.aws.dash0.com` does not
# resolve, and the only symptom is telemetry never arriving.
DASH0_ENDPOINT=https://ingress.us-east-1.aws.dash0.com:4317

# Which dataset the telemetry ships into, and the environment name it is
# tagged with. Both are optional.
DASH0_DATASET=default
DASH0_ENVIRONMENT=workshop

# Optional: browser monitoring for the frontend
#
# Off unless BOTH variables below are set. The browser talks to Dash0 directly
# rather than through the collector, so this token is served to browsers as part
# of the page. Create a SEPARATE auth token for it, scoped to Ingesting only and
# to this dataset only — never reuse DASH0_AUTH_TOKEN here.
#
# Use the OTLP-over-HTTP endpoint — same host as above, without the :4317 port.
# For US East that is:
# https://ingress.us-east-1.aws.dash0.com
DASH0_WEB_ENDPOINT=
DASH0_WEB_AUTH_TOKEN=

# Optional: turn all instrumentation off without editing anything else
# OTEL_SDK_DISABLED=true

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
